{
  "name": "hive-mind",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "typecheck": "pnpm --filter @hive-mind/mcp typecheck",
    "lint": "prettier --check .",
    "test": "node --test \"tests/**/*.test.mjs\" \".claude/hooks/*.test.mjs\"",
    "build": "pnpm --filter @hive-mind/mcp build",
    "test:live": "pnpm build && node --env-file=.env --test tests/mcp.integration.test.mjs",
    "demo": "node scripts/demo.mjs",
    "import:vault": "node --env-file=.env scripts/import-vault.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@electric-sql/pglite": "^0.2.17",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2",
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "*.{ts,js,mjs,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
