# Copy to .env and fill in. Never commit .env.
# The web app has its own two public values: see web/.env.example.
#
# Hosted dev project (dashboard → Project Settings → API):
SUPABASE_URL=https://tokyttkztrkjvkaksdnh.supabase.co
# Or the local stack (`pnpm db:start`, values from `supabase status`):
# SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Used by the MCP server to act as the member behind an agent token. Server-side only.
SUPABASE_JWT_SECRET=
# Shown once by create_agent(); see README.
HIVE_AGENT_TOKEN=
# Optional: the agent token of a second member of the same hive. Only the
# two-member part of `pnpm test:live` uses it, and skips itself without it.
HIVE_AGENT_TOKEN_2=
