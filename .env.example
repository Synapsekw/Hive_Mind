# Copy to .env and fill in. Never commit .env.
# The web app has its own two public values: see web/.env.example.
#
# Hosted dev project (dashboard → Project Settings → API):
SUPABASE_URL=https://tokyttkztrkjvkaksdnh.supabase.co
# Or the local stack (`pnpm db:start`, values from `supabase status`):
# SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Shown once when the agent is created (Settings, or create_agent(); see README).
# The MCP server exchanges it for a one-hour identity through the project's
# agent-session function. These three values are all an agent's machine needs.
HIVE_AGENT_TOKEN=
# Optional: the agent token of a second member of the same hive. Only the
# two-member part of `pnpm test:live` uses it, and skips itself without it.
HIVE_AGENT_TOKEN_2=
# Optional: a person's sign-in. Only for `pnpm test:live` (the checks that act as
# a person skip themselves without it) and unattended imports. Otherwise leave
# them empty: `pnpm import:vault` asks for the email and password itself.
# Use a test account here, never a password that is used anywhere else.
HIVE_PERSON_EMAIL=
HIVE_PERSON_PASSWORD=
# Optional: the same for the second member in the two-member checks.
HIVE_PERSON_EMAIL_2=
HIVE_PERSON_PASSWORD_2=
